# Sao chép file này thành .env rồi điền giá trị thật
DATABASE_URL=mysql+pymysql://root:<mat_khau>@localhost:3306/voltix?charset=utf8mb4
JWT_SECRET=<chuoi_ngau_nhien_dai>
SESSION_SECRET=<chuoi_ngau_nhien_khac>
# URL backend mà điện thoại truy cập được (emulator: http://10.0.2.2:8000)
PUBLIC_BASE_URL=http://10.0.2.2:8000
# Đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Tuỳ chọn: bật Claude cho tính năng AI build PC (https://console.anthropic.com)
ANTHROPIC_API_KEY=
